[Unit]
Description=Hermes Agent Dashboard (127.0.0.1:9119, upstream for the companion relay)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=@VENV@/bin/python -m hermes_cli.main dashboard --host 127.0.0.1 --port 9119 --no-open --skip-build
WorkingDirectory=@HERMES_HOME@
Environment="PATH=@VENV@/bin:@HOME@/.local/bin:/usr/local/bin:/usr/bin:/bin"
Environment="VIRTUAL_ENV=@VENV@"
Environment="HERMES_HOME=@HERMES_HOME@"
Restart=always
RestartSec=5
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
