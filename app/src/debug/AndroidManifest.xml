<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Debug-only L0 smoke-test surface. Present only in debug builds: this manifest and
      DirectToolboxTestReceiver.kt both live in src/debug, so neither is merged into a
      release APK.

      The receiver must be exported to be reachable from `adb shell am broadcast` (the
      shell runs as a different UID), so it is gated on android.permission.DUMP, which
      the adb shell holds and third-party apps cannot obtain. Without that gate any
      installed app could drive the L0 lane — including device.notifications.stream.set,
      which would let it redirect the notification stream to a gateway of its choosing.
    -->
    <application>
        <receiver
            android:name=".DirectToolboxTestReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="${applicationId}.test.L0" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
