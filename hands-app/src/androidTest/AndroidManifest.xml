<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- AGP installs this APK as app.hermes.hands.test. The fixture deliberately has a
         different UID/package from the production controller and contains no user data. -->
    <application android:label="Hands acceptance fixture" android:allowBackup="false">
        <activity
            android:name="app.hermes.hands.test.IsolatedControlFixtureActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:launchMode="standard"
            android:taskAffinity="app.hermes.hands.test.fixture"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
