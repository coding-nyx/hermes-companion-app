<resources>
    <style name="Theme.HermesHands" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#0A0C10</item>
        <item name="android:navigationBarColor">#0A0C10</item>
        <item name="android:windowBackground">#0A0C10</item>
        <item name="android:colorAccent">#0A84FF</item>
    </style>
    <string name="a11y_description">Allows an explicitly armed agent to read and operate the main screen. Hands always offers a stop control. Shizuku and the separate agent screen are optional.</string>
    <style name="Theme.HermesHands.PrivateEntry" parent="Theme.HermesHands">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
